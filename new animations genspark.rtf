\f1\b0 \cf0 Chaque branche est un segment de ligne droite allant du 
\f0\b bord du n\'9cud central
\f1\b0  (\'e0 70px du centre, soit le rayon du cercle central) jusqu'au 
\f0\b bord du n\'9cud satellite
\f1\b0  (\'e0 36px du centre du satellite).\
\pard\pardeftab720\sa332\partightenfactor0

\f0\b\fs20 \cf0 Calcul des points de d\'e9part et d'arriv\'e9e\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Pour chaque branche 
\f3\fs26 i
\f1\fs24 , en partant de l'angle 
\f11\fs26 \uc0\u952 
\f3 i
\f1\fs24  en radians :\
\pard\pardeftab720\qc\partightenfactor0

\f2\fs22 \cf4 \strokec4 \
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf5 \strokec5 // Point de d\'e9part (sur le bord du n\'9cud central)\
startX = 960 + 70 * Math.cos(\uc0\u952 i)\
startY = 520 + 70 * Math.sin(\uc0\u952 i)\
\
// Point d'arriv\'e9e (sur le bord du n\'9cud satellite)\
endX = satelliteX - 36 * Math.cos(\uc0\u952 i)\
endY = satelliteY - 36 * Math.sin(\uc0\u952 i)\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Ces valeurs doivent \'eatre d\'e9finies comme constantes dans le code.\strokec2 \
\pard\pardeftab720\sa332\partightenfactor0

