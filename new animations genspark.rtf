\f2\fs22 \cf4 \strokec4 \
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf5 \strokec5 genspark_progress = interpolate(frame, [35, 95], [0, 1], \{\
  easing: Easing.inOut(Easing.cubic),\
  extrapolateLeft: 'clamp',\
  extrapolateRight: 'clamp'\
\})\
\
gensparkWidth = 40 + genspark_progress * 560\
// Part de 40px (position commune au d\'e9part) et atteint 600px (la ligne des 12 mois)\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 \strokec2 Effet de vitesse sur la barre GenSpark (frames 40 
\f5 \uc0\u8594 
