\f1\fs24 \cf5 \strokec5 // Streak 1 : y = barTop + 12px, hauteur 2px, opacity 0.3\
// Streak 2 : y = barTop + 22px, hauteur 1px, opacity 0.2\
// Streak 3 : y = barTop + 32px, hauteur 2px, opacity 0.25\
// Background de chaque streak :\
// linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent)\
// Largeur de chaque streak = 60% de la largeur actuelle de la barre\
// Position X : d\'e9but de la barre + 20%\
\
streakOpacity = interpolate(frame, [40, 60, 85, 95], [0, 0.8, 0.8, 0], \{\
