\
// Amplitude maximale au d\'e9part : 22\'b0, d\'e9cro\'eet vers 0\'b0\
amplitude = interpolate(shakeFrame, [0, 24], [22, 0], \{\
  easing: Easing.out(Easing.cubic),\
  extrapolateLeft: 'clamp',\
  extrapolateRight: 'clamp'\
\})\
\
// Oscillation sinuso\'efdale\
rotation = amplitude * Math.sin((shakeFrame / 8) * 2 * Math.PI)\
