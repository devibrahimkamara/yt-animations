\f1\fs24 \cf5 \strokec5 // Circonf\'e9rence totale du cercle :\
circumference = 2 * Math.PI * 280 = ~1759px\
\
// 270\'b0 sur 360\'b0 = 75% de la circonf\'e9rence\
arcLength = circumference * 0.75 = ~1319px\
\
// stroke-dasharray : arcLength + (circumference - arcLength)\
// = 1319 + 440 = 1759 (= circumference)\
// On positionne le gap en bas du cercle gr\'e2ce \'e0 la rotation du SVG\
\
// stroke-dashoffset : anime de arcLength 
\f6 \uc0\u8594 
\f1  0 (remplit l'arc)\
dashOffset = interpolate(frame, [8, 130], [arcLength, 0], \{\
  easing: identique \'e0 la courbe du compteur (trois phases)\
\})\
