.64, "end": 10.92}, {"word": " souvent", "start": 10.92, "end": 11.18}, {"word": " en", "start": 11.18, "end": 11.34}, {"word": " une", "start": 11.34, "end": 11.46}, {"word": " demi", "start": 11.46, "end": 11.64}, {"word": "-heure.", "start": 11.64, "end": 11.82}]}, {"start": 12.880000000000004, "end": 17.36, "text": " 2. Tu choisis ta tâche la plus importante l'avenir, comme ça au réveillé t'attaques direct.", "words": [{"word": " 2.", "start": 12.880000000000004, "end": 13.320000000000002}, {"word": " Tu", "start": 13.320000000000002, "end": 13.76}, {"word": " choisis", "start": 13.76, "end": 14.06}, {"word": " ta", "start": 14.06, "end": 14.2}, {"word": " tâche", "start": 14.2, "end": 14.46}, {"word": " la", "start": 14.46, "end": 14.62}, {"word": " plus", "start": 14.62, "end": 14.76}, {"word": " importante", "start": 14.76, "end": 15.16}, {"word": " l", "start": 15.16, "end": 15.32}, {"word": "'avenir,", "start": 15.32, "end": 15.64}, {"word": " comme", "start": 15.74, "end": 16.22}, {"word": " ça", "start": 16.22, "end": 16.36}, {"word": " au", "start": 16.36, "end": 16.48}, {"word": " réveillé", "start": 16.48, "end": 16.82}, {"word": " t", "start": 16.82, "end": 16.9}, {"word": "'attaques", "start": 16.9, "end": 17.14}, {"word": " direct.", "start": 17.14, "end": 17.36}]}, {"start": 18.14, "end": 24.7, "text": " 3. Tes mails et ton message, c'est à heure fixe, pas au réveillé, sinon tu gestes les urgences des autres.", "words": [{"word": " 3.", "start": 18.14, "end": 18.58}, {"word": " Tes", "start": 19.14, "end": 19.58}, {"word": " mails", "start": 19.58, "end": 19.88}, {"word": " et", "start": 19.88, "end": 19.98}, {"word": " ton", "start": 19.98, "end": 20.1}, {"word": " message,", "start": 20.1, "end": 20.4}, {"word": " c", "start": 20.62, "end": 20.96}, {"word": "'est", "start": 20.96, "end": 21.08}, {"word": " à", "start": 21.08, "end": 21.1}, {"word": " heure", "start": 21.1, "end": 21.24}, {"word": " fixe,", "start": 21.24, "end": 21.7}, {"word": " pas", "start": 21.7, "end": 22.14}, {"word": " au", "start": 22.14, "end": 22.26}, {"word": " réveillé,", "start": 22.26, "end": 22.74}, {"word": " sinon", "start": 22.76, "end": 23.24}, {"word": " tu", "start": 23.24, "end": 23.44}, {"word": " gestes", "start": 23.44, "end": 23.84}, {"word": " les", "start": 23.84, "end": 23.94}, {"word": " urgences", "start": 23.94, "end": 24.36}, {"word": " des", "start": 24.36, "end": 24.48}, {"word": " autres.", "start": 24.48, "end": 24.7}]}, {"start": 25.540000000000003, "end": 28.58, "text": " Franchement, mise bout à pisse, ça peut te rendre deux heures par jour.", "words": [{"word": " Franchement,", "start": 25.540000000000003, "end": 25.98}, {"word": " mise", "start": 26.04, "end": 26.32}, {"word": " bout", "start": 26.32, "end": 26.48}, {"word": " à", "start": 26.48, "end": 26.62}, {"word": " pisse,", "start": 26.62, "end": 26.86}, {"word": " ça", "start": 26.98, "end": 27.26}, {"word": " peut", "start": 27.26, "end": 27.44}, {"word": " te", "start": 27.44, "end": 27.54}, {"word": " rendre", "start": 27.54, "end": 27.72}, {"word": " deux", "start": 27.72, "end": 28.02}, {"word": " heures", "start": 28.02, "end": 28.22}, {"word": " par", "start": 28.22, "end": 28.36}, {"word": " jour.", "start": 28.36, "end": 28.58}]}], "text": " Tu perds deux heures chaque matin sans t'en rendre compte.  Trois habitudes pour les récupérer.  1. Pas de téléphone la première heure, parce que juste deux minutes sur une app, ça finit souvent en une demi-heure.  2. Tu choisis ta tâche la plus importante l'avenir, comme ça au réveillé t'attaques direct.  3. Tes mails et ton message, c'est à heure fixe, pas au réveillé, sinon tu gestes les urgences des autres.  Franchement, mise bout à pisse, ça peut te rendre deux heures par jour."}