\f3\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Le trac\'e9 SVG via 
\f4 \cf4 \strokec4 getTotalLength()
\f3 \cf0 \strokec2  : cr\'e9er le 
\f4 \cf4 \strokec4 <path>
