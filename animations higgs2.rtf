\ls9\ilvl0
\f2\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Les 5 cartes-modules apparaissent en cascade, delay de 4 frames entre chaque (frame 0, 4, 8, 12, 16 pour le d\'e9but de chaque spring).\
\ls9\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chaque carte : 
\f3 \cf3 \strokec3 opacity
\f2 \cf0 \strokec2  0\uc0\u8594 1, 
\f3 \cf3 \strokec3 translateY
\f2 \cf0 \strokec2  20px\uc0\u8594 0, 
\f3 \cf3 \strokec3 spring(\{damping: 14, stiffness: 140\})
\f2 \cf0 \strokec2 .\
\ls9\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'c9tat visuel neutre : fond gris fonc\'e9 d\'e9satur\'e9 (ex. 
\f3 \cf3 \strokec3 #2C2C2E
\f2 \cf0 \strokec2 ), bordure fine grise (
\f3 \cf3 \strokec3 #48484A
\f2 \cf0 \strokec2 ), ic\'f4ne en gris clair, aucune ombre port\'e9e.\
\ls9\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Position en diagonale l\'e9g\'e8re : chaque module descend d'environ 15-20px par rapport au pr\'e9c\'e9dent, de gauche \'e0 droite (ex. module 1 en haut, module 5 l\'e9g\'e8rement plus bas), pour casser la monotonie d'un alignement strictement horizontal.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls9\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Le c\'e2ble reliant les 5 modules est visible d\'e8s le d\'e9part, mais en pointill\'e9s gris neutres et \'e0 faible opacit\'e9 (0,3), dessin\'e9 en 
\f3 \cf3 \strokec3 strokeDasharray
\f2 \cf0 \strokec2  statique (pas encore anim\'e9).\
\pard\pardeftab720\sa320\partightenfactor0

