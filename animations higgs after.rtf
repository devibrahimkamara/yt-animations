\f0\b \cf0 Les trois obstacles
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls37\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Positionn\'e9s exactement sur le trac\'e9 de la courbe (pas \'e0 c\'f4t\'e9), \'e0 intervalles r\'e9guliers sur le plateau.\
\ls37\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chaque obstacle : une petite ic\'f4ne ou juste un point marqu\'e9 (rond plein) avec un libell\'e9 qui sort en 
\f4 \cf3 \strokec3 slide + fade
\f2 \cf0 \strokec2  vers le haut au moment pr\'e9cis o\'f9 le trac\'e9 de la courbe atteint ce point.\
\ls37\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Libell\'e9s courts, un mot ou deux : "Keyframes", "Courbes de vitesse", "Expressions".\
\ls37\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chaque obstacle reste affich\'e9 une fois apparu (ils s'accumulent \'e0 l'\'e9cran, pas de disparition avant la fin).\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls37\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 L\'e9ger effet de "ralentissement" du trac\'e9 au passage de chaque obstacle (la vitesse de dessin diminue l\'e9g\'e8rement pendant 0,3 s) pour sugg\'e9rer visuellement que ce sont des points de friction.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le mot final
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls38\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 "tr\'e8s demandant" s'imprime \'e0 la toute fin du trac\'e9, positionn\'e9 juste au-dessus du point d'arriv\'e9e de la courbe.\
\ls38\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Apparition en 
\f4 \cf3 \strokec3 typewriter
\f2 \cf0 \strokec2  (lettre par lettre, rapide, ~0,6 s pour tout le mot) plut\'f4t qu'un fade classique \'97 \'e7a donne un effet plus "verdict qui tombe" que les autres apparitions du plan.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls38\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Couleur l\'e9g\'e8rement diff\'e9rente des libell\'e9s d'obstacles (plus contrast\'e9e, ex. blanc pur ou couleur d'alerte discr\'e8te) pour marquer que c'est la conclusion du graphique.\
\pard\pardeftab720\sa53\partightenfactor0

