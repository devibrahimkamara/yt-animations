\f0\b \cf0 C\'f4t\'e9 droit \'97 "Niveau r\'e9el"
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls2\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Fond gris tr\'e8s fonc\'e9, l\'e9g\'e8rement diff\'e9rent du noir de gauche pour bien marquer la s\'e9paration m\'eame sans la ligne de partage.\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Titre en haut : "Mon niveau After Effects" (apparition simple, fade + l\'e9ger slide vers le haut, 0,3 s).\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Une jauge verticale ou horizontale (barre de progression styl\'e9e, pas un cercle \'97 plus lisible en 6 s) avec graduations 0-100%.\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Comportement de la jauge : elle part de 0, monte en tremblotant jusqu'\'e0 environ 15-20% max (mouvement nerveux, plusieurs petits \'e0-coups, pas une courbe lisse \'97 \'e7a doit avoir l'air de "forcer"), puis retombe d'un coup \'e0 0% avec un effet de rebond mou (pas un spring \'e9nergique, plut\'f4t un affaissement).\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Un chiffre num\'e9rique au-dessus de la jauge qui suit exactement son mouvement en temps r\'e9el.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls2\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Une fois fig\'e9 \'e0 0%, le chiffre fait un pulse d'\'e9chelle (1 \uc0\u8594  1.15 \u8594  1) une fois, pour attirer l'\'9cil.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Ligne de s\'e9paration
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls3\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Diagonale \'e0 environ 15-20\'b0 d'inclinaison (pas verticale pure \'97 plus dynamique).\
\ls3\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Trait fin lumineux (2-3px, couleur d'accent de ta charte, ex. un orange ou un bleu \'e9lectrique) qui marque la fronti\'e8re, avec une l\'e9g\'e8re lueur (glow) autour.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls3\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Elle se d\'e9place de hors-cadre gauche \'e0 sa position finale (environ au centre, l\'e9g\'e8rement d\'e9cal\'e9e si tu veux d\'e9s\'e9quilibrer la composition) en 0,8 s, easing type 
\f4 \cf3 \strokec3 easeOutCubic
\f2 \cf0 \strokec2  pour un effet qui ralentit en arrivant.\
\pard\pardeftab720\sa53\partightenfactor0

