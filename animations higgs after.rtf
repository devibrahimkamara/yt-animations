\f0\b\fs29\fsmilli14667 \cf0 La checklist
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls42\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Titre en haut : "Ce qu'il te faut" \'97 typo claire, pas d'effet sp\'e9cial, apparition simple en fade + l\'e9ger slide.\
\ls42\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Trois lignes dispos\'e9es verticalement, chacune avec :\
\pard\tx940\tx1440\pardeftab720\li1440\fi-1440\partightenfactor0
\ls42\ilvl1\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Une case \'e0 cocher \'e0 gauche (carr\'e9 vide, non coch\'e9e \'97 c'est volontaire, on ne valide rien ici, on liste juste les pr\'e9requis).\
\ls42\ilvl1\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Un texte \'e0 droite de la case.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls42\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ligne 1 : "ChatGPT Pro" \'97 le seul texte r\'e9ellement lisible du plan.\
\ls42\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ligne 2 : texte flout\'e9 en permanence (le spectateur ne doit jamais pouvoir le lire, m\'eame en pause) \'97 dans ta t\'eate ce sera probablement "ChatGPT Desktop" ou un autre pr\'e9requis mentionn\'e9 plus loin dans le script.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls42\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ligne 3 : idem, flout\'e9 en permanence \'97 un autre pr\'e9requis futur.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le m\'e9canisme de flou
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls43\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Les 3 lignes apparaissent flout\'e9es d'un coup (flou fort, genre 12-15px).\
\ls43\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Seule la ligne 1 se d\'e9nette progressivement, de mani\'e8re fluide et continue (pas par \'e0-coups), pendant que la voix off prononce "ChatGPT" \'97 le timing du d\'e9nettage doit coller \'e0 l'instant exact o\'f9 le mot est prononc\'e9, c'est ce qui cr\'e9e la sensation de synchronisation intelligente.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls43\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Les lignes 2 et 3 restent flout\'e9es tout du long, mais pas fig\'e9es : une tr\'e8s l\'e9g\'e8re oscillation du niveau de flou (par exemple entre 12px et 14px, cycle lent de 2 s) pour donner une impression de "pr\'e9sence vivante" plut\'f4t qu'un simple placeholder statique.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Cases \'e0 cocher
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls44\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Restent vides tout le long du plan, m\'eame pour la ligne 1 qui est lisible \'97 l'id\'e9e est qu'on \'e9nonce les pr\'e9requis, on ne les valide pas encore (la validation/coche pourrait \'eatre un running gag dans un futur plan de la vid\'e9o, si tu r\'e9p\'e8tes cette checklist plus tard avec les cases qui se remplissent une par une).\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls44\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Design simple : contour fin, coins l\'e9g\'e8rement arrondis, couleur neutre (gris clair ou couleur d'accent en version tr\'e8s att\'e9nu\'e9e).\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Typographie et couleurs
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls45\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Fond sombre neutre, coh\'e9rent avec le reste de la vid\'e9o.\
\ls45\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Texte de la ligne 1 en blanc net, bien contrast\'e9.\
\ls45\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Texte des lignes 2-3 dans la m\'eame couleur mais rendu illisible par le flou \'97 ne choisis pas une couleur diff\'e9rente ou plus sombre pour elles, sinon l'\'9cil comprend imm\'e9diatement qu'elles sont "d\'e9sactiv\'e9es" plut\'f4t que "cach\'e9es".\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls45\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Titre en couleur d'accent r\'e9currente ou en blanc, selon ce qui ressort le mieux visuellement.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Sp\'e9cifications techniques pour Remotion
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls46\ilvl0
\f4\b0\fs29\fsmilli14667 \cf3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec3 filter: blur(Xpx)
\f2 \cf0 \strokec2  sur chaque ligne de texte, avec 
\f4 \cf3 \strokec3 X
\f2 \cf0 \strokec2  interpol\'e9 ind\'e9pendamment par ligne.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls46\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ligne 1 : 
\f4 \cf3 \strokec3 interpolate(frame, [debut, fin], [14, 0], \{ easing: Easing.out(Easing.cubic) \})
\f2 \cf0 \strokec2 .\
\ls46\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Lignes 2-3 : flou de base fixe (~13px) avec une oscillation superpos\'e9e, par exemple 
\f4 \cf3 \strokec3 13 + Math.sin(frame / 20) * 1
\f2 \cf0 \strokec2  pour la respiration.\
\ls46\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Important : le 
\f4 \cf3 \strokec3 blur
\f2 \cf0 \strokec2  doit \'eatre appliqu\'e9 uniquement sur le texte (pas sur la case \'e0 cocher), donc isole bien le texte dans son propre conteneur avec le filtre, distinct du conteneur de la case.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls46\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Titre et apparition des lignes : simples 
\f4 \cf3 \strokec3 interpolate
\f2 \cf0 \strokec2  sur 
\f4 \cf3 \strokec3 opacity
\f2 \cf0 \strokec2  + 
\f4 \cf3 \strokec3 translateY
\f2 \cf0 \strokec2 , rien de complexe ici \'97 la complexit\'e9 du plan doit venir uniquement du m\'e9canisme de flou, pas de la mise en page.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Ce qu'il ne faut pas faire
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls47\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas rendre les lignes 2 et 3 lisibles m\'eame partiellement, \'e0 aucun moment du plan, y compris sur une image fig\'e9e \'97 c'est toute la m\'e9canique de r\'e9tention qui s'effondre sinon.\
\ls47\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas ajouter d'animation d'entr\'e9e complexe (pas de spring, pas de rebond) \'97 le contraste avec les plans 2 et 3 (tr\'e8s \'e9nergiques) doit rester net ; ici tout doit \'eatre feutr\'e9, presque chuchot\'e9.\
\ls47\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas cocher la case de la ligne 1 m\'eame si elle est lisible \'97 la validation viendrait trop t\'f4t et casserait la promesse implicite "attends la suite pour voir la liste compl\'e8te et valid\'e9e".\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls47\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas d\'e9passer 5,5 s : ce plan fonctionne parce qu'il est court et frustrant, pas parce qu'il s'attarde.\
\pard\pardeftab720\sa106\partightenfactor0

