\f0\b\fs29\fsmilli14667 \cf0 La carte pricing
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls48\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Format carte verticale ou carr\'e9e, centr\'e9e \'e0 l'\'e9cran, fond l\'e9g\'e8rement contrast\'e9 par rapport \'e0 l'arri\'e8re-plan g\'e9n\'e9ral (un ton plus clair ou un d\'e9grad\'e9 subtil, fa\'e7on carte de cr\'e9dit premium).\
\ls48\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Coins arrondis, l\'e9g\'e8re ombre port\'e9e pour donner du volume.\
\ls48\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Entr\'e9e en sc\'e8ne : part d'une rotation 3D sur l'axe X (environ 15-20\'b0 d'inclinaison, comme si elle \'e9tait pos\'e9e en biais) et se redresse progressivement jusqu'\'e0 0\'b0 \'97 effet "carte qui se pose sur la table" plut\'f4t qu'un simple fade ou slide.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls48\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Une fois pos\'e9e, la carte reste totalement statique pendant que les \'e9l\'e9ments \'e0 l'int\'e9rieur (badge, compteur) s'animent \'97 elle sert de socle fixe.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le badge "GPT-6 Astra"
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls49\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Petit encart/pastille avec le texte "GPT-6 Astra", couleur distincte de la carte (couleur d'accent de ta charte, ou un d\'e9grad\'e9 sp\'e9cifique pour signaler "nouveaut\'e9/version premium").\
\ls49\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Arrive du haut du cadre, hors champ, et tombe verticalement jusqu'\'e0 sa position sur la carte (juste au-dessus ou \'e0 c\'f4t\'e9 du compteur).\
\ls49\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Rebond net \'e0 l'arriv\'e9e \'97 un vrai rebond physique (descend, d\'e9passe l\'e9g\'e8rement sa position finale, remonte un peu, se stabilise), pas juste un ralentissement en fin de course.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls49\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Peut \'eatre l\'e9g\'e8rement inclin\'e9 \'e0 l'arriv\'e9e puis se redresser dans le m\'eame mouvement, pour renforcer l'effet "objet qui tombe et se pose."\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le compteur odom\'e8tre
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls50\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Zone centrale de la carte, gros chiffres.\
\ls50\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 M\'e9canique odom\'e8tre : chaque chiffre (dizaine, unit\'e9) est une colonne verticale de chiffres empil\'e9s de 0 \'e0 9, qui d\'e9file verticalement et se fige sur la bonne valeur \'97 comme un compteur kilom\'e9trique m\'e9canique, pas un simple texte qui change.\
\ls50\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Va de "00" \'e0 "20", d\'e9filement rapide au d\'e9but puis qui ralentit nettement en approchant "20" (pas de vitesse constante) pour donner l'impression d'un m\'e9canisme qui "trouve" sa valeur finale.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls50\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Les deux colonnes (dizaine et unit\'e9) peuvent s'arr\'eater \'e0 des instants l\'e9g\'e8rement diff\'e9rents (dizaine se fige en premier, unit\'e9 juste apr\'e8s) pour un rendu plus m\'e9canique et moins synth\'e9tique.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le libell\'e9 "$ / mois"
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls51\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Appara\'eet juste apr\'e8s que le compteur soit fig\'e9, accroch\'e9 \'e0 droite ou en dessous du chiffre.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls51\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Animation simple : l\'e9ger slide + fade, rien de complexe \'97 le compteur a d\'e9j\'e0 consomm\'e9 toute l'attention du spectateur, ce libell\'e9 est un compl\'e9ment de lecture, pas un nouveau point focal.\
\pard\pardeftab720\sa53\partightenfactor0

