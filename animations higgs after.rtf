\f0\b \cf0 Ce qu'il ne faut pas faire
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls60\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas utiliser deux \'e9l\'e9ments s\'e9par\'e9s avec un fondu crois\'e9 entre eux \'97 \'e7a d\'e9truirait compl\'e8tement l'effet "objet unique qui se transforme", qui est toute la valeur de ce plan.\
\ls60\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas faire un morph trop rapide (moins de 2,5 s) \'97 la transformation doit \'eatre visible et compr\'e9hensible en train de se faire, pas juste un avant/apr\'e8s.\
\ls60\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas ajouter d'effets superflus (particules, flash, glow) \'97 ce plan doit rester le plus "produit fini, propre, professionnel" de toute la s\'e9quence, en coh\'e9rence avec le sujet (une vraie app desktop).\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls60\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas d\'e9passer 7 s : au-del\'e0, la fen\'eatre finale statique commence \'e0 tra\'eener sans rien ajouter.\
\pard\pardeftab720\sa106\partightenfactor0

