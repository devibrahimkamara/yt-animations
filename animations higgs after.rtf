\f0\b \cf0 Ce qu'il ne faut pas faire
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls34\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas faire appara\'eetre les 6 cases en m\'eame temps \'97 la cascade progressive est ce qui cr\'e9e la sensation de richesse cumulative.\
\ls34\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas utiliser la m\'eame micro-animation (m\'eame easing, m\'eame direction) sur deux cases diff\'e9rentes \'97 chacune doit avoir sa propre signature de mouvement.\
\ls34\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas couper brutalement au zoom final (pas de hard cut) \'97 la transition doit \'eatre fluide, sinon elle casse le sentiment de continuit\'e9 entre "vue d'ensemble" et "d\'e9tail".\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls34\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ne pas d\'e9passer 6 cases : au-del\'e0, le texte et les micro-animations deviennent illisibles en 9 secondes.\
\pard\pardeftab720\sa106\partightenfactor0

