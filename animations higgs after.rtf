\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls52\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Fond g\'e9n\'e9ral sombre, coh\'e9rent avec les autres plans.\
\ls52\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Carte dans un ton l\'e9g\'e8rement plus clair ou avec un d\'e9grad\'e9 propre \'e0 elle (pour se distinguer nettement du fond).\
\ls52\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Badge "GPT-6 Astra" dans ta couleur d'accent r\'e9currente.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls52\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chiffres de l'odom\'e8tre en blanc, tr\'e8s gros, police \'e0 chiffres bien lisibles m\'eame en d\'e9filement rapide (\'e9viter les polices trop fines pour cet \'e9l\'e9ment pr\'e9cis).\
