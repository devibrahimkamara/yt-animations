\f0\b \cf0 Les lignes de liaison
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls62\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Trois lignes reliant chaque paire de n\'9cuds (triangle complet : ChatGPT\uc0\u8596 Fichiers, ChatGPT\u8596 AE, Fichiers\u8596 AE).\
\ls62\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Se tracent en 
\f4 \cf3 \strokec3 stroke-dashoffset
\f2 \cf0 \strokec2 , une ligne apr\'e8s l'autre avec un l\'e9ger chevauchement (la deuxi\'e8me commence avant que la premi\'e8re ait totalement fini), sur une dur\'e9e totale de 2,4 s pour les trois.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls62\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Trait fin, couleur d'accent att\'e9nu\'e9e (moins intense que les paquets qui vont circuler dessus, pour bien distinguer "le chemin" du "signal qui circule").\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Les paquets lumineux
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls63\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Petits points ou courts segments lumineux qui se d\'e9placent le long des lignes d\'e9j\'e0 trac\'e9es, en boucle continue, dans les deux sens (pas uniquement ChatGPT \uc0\u8594  AE, mais aussi des retours, pour sugg\'e9rer un dialogue permanent et pas un simple envoi \'e0 sens unique).\
\ls63\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Plusieurs paquets actifs simultan\'e9ment sur des liaisons diff\'e9rentes pour donner une sensation de syst\'e8me vivant, sans toutefois surcharger (2-3 paquets visibles max \'e0 un instant donn\'e9).\
\ls63\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Vitesse de d\'e9placement mod\'e9r\'e9e, constante, pas d'acc\'e9l\'e9ration \'97 le rythme doit rester lisible et un peu hypnotique, pas nerveux.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls63\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Tra\'een\'e9e lumineuse courte derri\'e8re chaque paquet (comme une com\'e8te) pour renforcer la sensation de mouvement fluide.\
\pard\pardeftab720\sa53\partightenfactor0

\f0\b \cf0 Le pulse du n\'9cud After Effects
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls64\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 \'c0 chaque fois qu'un paquet arrive sur le n\'9cud "After Effects" (peu importe d'o\'f9 il vient), le n\'9cud fait un pulse net : l\'e9ger 
\f4 \cf3 \strokec3 scale
\f2 \cf0 \strokec2  up puis retour, accompagn\'e9 d'un flash bref de son contour (glow qui s'intensifie puis retombe).\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls64\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Ce pulse doit \'eatre perceptible mais bref (0,3-0,4 s), pour ne pas donner l'impression que le n\'9cud "palpite" en continu \'97 c'est une r\'e9action \'e0 un \'e9v\'e9nement pr\'e9cis, pas une animation de fond.\
\pard\pardeftab720\sa53\partightenfactor0

