\f0\b\fs29\fsmilli14667 \cf0 Les trois n\'9cuds
\f1\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls61\ilvl0
\f2\b0\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Dispos\'e9s en triangle \'e0 l'\'e9cran : "ChatGPT Desktop" en haut, "Tes fichiers" en bas \'e0 gauche, "After Effects" en bas \'e0 droite (ou une disposition \'e9quivalente qui garde une bonne lisibilit\'e9).\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chaque n\'9cud est repr\'e9sent\'e9 par une forme simple (cercle ou hexagone arrondi) avec une ic\'f4ne ou un logo \'e0 l'int\'e9rieur, et un libell\'e9 en dessous.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 N\'9cud "ChatGPT Desktop" : logo ChatGPT.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 N\'9cud "Tes fichiers" : ic\'f4ne de dossier g\'e9n\'e9rique.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 N\'9cud "After Effects" : logo Adobe After Effects.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls61\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Apparition en pop (scale 0 \uc0\u8594  1) avec un tr\'e8s l\'e9ger d\'e9calage entre les trois (0,1-0,15 s), pas de stagger long ici \'97 contrairement au plan 4, on veut que le "syst\'e8me" semble d\'e9j\'e0 l\'e0, pr\'eat, pas en cours de construction lente.\
