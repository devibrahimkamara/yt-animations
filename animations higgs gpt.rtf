\f0\fs29\fsmilli14667 \cf0 Phase 1 \'97 Entr\'e9e de la barre de lecture (0 \'e0 15 frames / 0 \'e0 0,5s)
\f3\b0\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls1\ilvl0
\f2\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Une barre de progression type lecteur vid\'e9o (style YouTube/Netflix) appara\'eet en glissant depuis le bas de l'\'e9cran, 
\f4 \cf4 \strokec4 translateY
\f2 \cf0 \strokec2  de 100px vers 0, avec 
\f4 \cf4 \strokec4 Easing.out(Easing.cubic)
\f2 \cf0 \strokec2 .\
\ls1\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 La barre fait environ 80% de la largeur du canvas, centr\'e9e horizontalement, positionn\'e9e dans le tiers inf\'e9rieur.\
\ls1\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Un curseur circulaire (le "playhead") est positionn\'e9 \'e0 l'extr\'eame droite de la barre au d\'e9part.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls1\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Fondu d'opacit\'e9 simultan\'e9 de 0 \'e0 1.\
\pard\pardeftab720\sa320\partightenfactor0

\f0\b \cf0 Phase 2 \'97 Rembobinage (15 \'e0 60 frames / 0,5 \'e0 2s)
\f3\b0\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls2\ilvl0
\f2\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Le playhead glisse de droite \'e0 gauche le long de la barre, avec 
\f4 \cf4 \strokec4 interpolate
\f2 \cf0 \strokec2  et un easing qui acc\'e9l\'e8re puis ralentit l\'e9g\'e8rement (
\f4 \cf4 \strokec4 Easing.inOut(Easing.quad)
\f2 \cf0 \strokec2 ).\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Au-dessus de la barre, 4 \'e0 5 vignettes rectangulaires (ratio 16:9, simples rectangles avec d\'e9grad\'e9 ou ic\'f4nes abstraites \'97 pas besoin de vraies images, des placeholders g\'e9om\'e9triques suffisent) d\'e9filent horizontalement de droite \'e0 gauche, comme un scrubbing de timeline.\
\ls2\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Chaque vignette a un 
\f4 \cf4 \strokec4 blur
\f2 \cf0 \strokec2  l\'e9ger (2 \'e0 4px) qui pulse pendant le d\'e9filement pour sugg\'e9rer le mouvement rapide.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
\ls2\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Optionnel : un l\'e9ger effet de "trail" (tra\'een\'e9e d'opacit\'e9 d\'e9gressive) derri\'e8re le playhead pour renforcer la sensation de vitesse.\
\pard\pardeftab720\sa320\partightenfactor0

\f0\b \cf0 Phase 3 \'97 Arr\'eat et estampillage du badge (60 \'e0 135 frames / 2 \'e0 4,5s)
\f3\b0\fs24 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls3\ilvl0
\f2\fs29\fsmilli14667 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Le playhead s'arr\'eate net \'e0 l'extr\'e9mit\'e9 gauche de la barre (position 0%).\
\ls3\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Un badge central appara\'eet au centre de l'\'e9cran, par-dessus les vignettes qui se figent et s'assombrissent l\'e9g\'e8rement (overlay noir \'e0 40% d'opacit\'e9 pour faire ressortir le badge).\
\ls3\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Le badge : forme arrondie (pill ou hexagone l\'e9ger), texte "100% GPT-6 ASTRA" en majuscules, police bold/condensed.\
\ls3\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Animation d'entr\'e9e du badge : 
\f4 \cf4 \strokec4 spring
\f2 \cf0 \strokec2  avec 
\f4 \cf4 \strokec4 damping: 10
\f2 \cf0 \strokec2 , 
\f4 \cf4 \strokec4 stiffness: 120
\f2 \cf0 \strokec2 , 
\f4 \cf4 \strokec4 mass: 0.8
