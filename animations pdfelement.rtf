\outl0\strokewidth0 \strokec2 Police claire et lisible, taille moyenne (ex. 20-24px), couleur blanche ou accent, positionn\'e9es individuellement sous chaque ic\'f4ne concern\'e9e\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa320\partightenfactor0
